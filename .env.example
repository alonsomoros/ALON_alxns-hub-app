# API de persistencia accesible por Tailscale desde la PWA.
# En la Raspberry, el backend escucha en 0.0.0.0:8787.
VITE_PERSISTENCE_API_URL=http://100.x.x.x:8787

# Variables del backend en la Raspberry.
HOST=0.0.0.0
PORT=8787
DB_PATH=./data/alon-hub.sqlite
ALLOWED_ORIGINS=http://100.x.x.x:4173,http://localhost:5173

# Métricas de la Raspberry (REQ-011). Prometheus ya publicado en la Pi; el proxy de Docker es opcional.
PROMETHEUS_URL=http://host.docker.internal:9090
DOCKER_PROXY_URL=http://docker-proxy:2375
PROMETHEUS_JOB=raspberrypi_host
DEVICE_ID=raspberry-pi-5

# Cita del día (REQ-021). Opcional: origen de la frase en español (JSON con phrase/content y author).
# QUOTE_URL=https://frasedeldia.azurewebsites.net/api/phrase
